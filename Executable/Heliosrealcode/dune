(executable
 (name main)
 ; Cryptokit raises an alert on SHA-1, correctly: it is collision
 ; broken.  Deployed Helios derives its challenges with it, so a
 ; verifier for published ballots has no choice but to use it.  That
 ; is a fact about Helios, not about this code, and the alert is
 ; silenced here rather than in the library.
 (flags (:standard -alert -crypto))
 (libraries Helioslib unix cryptokit yojson))
